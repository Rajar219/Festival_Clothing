rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FESTIVAL CLOTHING POS - Live Sales Bills Collection
    // Allows seamless live synchronization between PC and Mobile terminals
    match /sales_bills/{billId} {
      allow read, write: if true;
    }
    
    // Staff authorization collection
    match /approved_staff/{email} {
      allow read, write: if true;
    }
  }
}
